# ==============================================================================
# Foodgo Environment Variables Template (Databaseless File-Storage Edition)
# ==============================================================================

# Application Details
APP_NAME="Foodgo"
APP_URL="https://example.com"
APP_ENV="production"
APP_SECRET="YOUR_RANDOM_CRYPTOGRAPHIC_SECRET_KEY_HERE"
PORT=3000

# Storage Engine (FileStore JSON - No MySQL required)
STORAGE_ENGINE="FileStore"
DATA_DIR="./data"

# API Configuration (Optional: set when deploying frontend separately or behind reverse proxy/aaPanel)
# Default is empty string for same-origin relative /api requests
VITE_API_BASE_URL=""
NEXT_PUBLIC_API_URL=""

# UPI & Instant Payment Defaults
UPI_ID="foodgo@upi"
UPI_MERCHANT_NAME="Foodgo Foods Pvt Ltd"
VITE_MERCHANT_UPI_ID="foodgo@upi"

# GEMINI_API_KEY: Optional for Gemini AI Assistant
GEMINI_API_KEY=""
